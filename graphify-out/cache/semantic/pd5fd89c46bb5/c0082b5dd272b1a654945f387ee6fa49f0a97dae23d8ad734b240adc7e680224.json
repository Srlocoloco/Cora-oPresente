ackend_readme_rotas", "relation": "conceptually_related_to", "confidence": "AMBIGUOUS", "confidence_score": 0.25, "source_file": "backend-php/README.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "fluxo_cobranca_pix_sicredi", "label": "Fluxo de cobran\u00e7a PIX Sicredi (credenciais, certificado, webhook e reserva est\u00e1tica)", "nodes": ["backend_readme_pix_sicredi", "backend_php_readme_pix_sicredi", "backend_readme_certificado_pem", "backend_certs_coloque_os_certificados_aqui_certificados_pix", "backend_php_readme_webhook_pix", "backend_php_readme_qr_pix_estatico"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "backend-php/README.md"}, {"id": "avisos_de_pedido_ao_cliente", "label": "Avisos de pedido ao cliente (e-mail, Web Push no PWA e rastreamento)", "nodes": ["backend_php_readme_smtp", "backend_php_readme_mail_nativo", "backend_php_readme_web_push_vapid", "backend_php_readme_correios_rastreamento", "index_pwa_manifest"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "backend-php/README.md"}]}