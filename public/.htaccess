# ─── Segurança do site (arquivos estáticos em public_html) ──────────────────
# O "npm run build" copia este arquivo automaticamente para dentro de dist/
# (pasta "public/" do Vite vira a raiz do site publicado) — não precisa
# copiar manualmente, só publicar o dist/ como sempre.

# Força HTTPS sempre, mesmo que alguém acesse por engano com http://
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  # HSTS: depois do primeiro acesso, o navegador nunca mais tenta http:// de
  # novo neste domínio por conta própria (protege contra downgrade de https)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Impede que o navegador "adivinhe" o tipo de um arquivo (evita truques de
  # disfarçar um arquivo malicioso como se fosse outra coisa)
  Header always set X-Content-Type-Options "nosniff"

  # Bloqueia o site de ser carregado dentro de um <iframe> em outro site
  # (evita "clickjacking" — clique disfarçado sobre um botão invisível)
  Header always set X-Frame-Options "DENY"

  # Não envia a URL completa como referer para outros sites ao clicar num link
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Restringe câmera/microfone/geolocalização — o site não usa nenhum
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Content-Security-Policy: a trava contra injeção de JavaScript. O navegador
  # só executa script vindo do próprio site e do login do Google — script
  # colado num campo de texto, num comentário de avaliação ou pela URL não
  # roda, porque script-src não tem 'unsafe-inline' nem 'unsafe-eval'.
  #
  # O que cada linha libera (tudo que o site usa de fora, e só isso):
  #   script  → login do Google
  #   style   → Google Fonts ('unsafe-inline' é exigido pelo Tailwind/React)
  #   img     → data:/blob: (fotos de produto em base64) e o QR do PIX
  #   media   → data:/blob: (vídeo enviado nas avaliações)
  #   connect → ViaCEP (frete), Google (login); a API é o próprio domínio
  #   frame   → só o iframe do login do Google
  # Serviço externo novo (analytics, chat, pixel) precisa entrar aqui, senão o
  # navegador bloqueia — esse é o comportamento esperado.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://api.qrserver.com https://lh3.googleusercontent.com; media-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://viacep.com.br https://accounts.google.com https://oauth2.googleapis.com; frame-src https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>
