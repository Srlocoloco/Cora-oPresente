# Endereço público do backend (banco de dados + cobranças PIX do Sicredi).
#
# Hospedagem definitiva: HostGator (tudo no mesmo domínio — veja
# backend-php/README.md). Antes de rodar "npm run build" no seu computador
# para publicar, copie este arquivo para ".env" e troque pelo seu domínio real
# (o mesmo onde a pasta backend-php/api vai ficar, em /api).
#
# Sem esse arquivo, o site usa http://localhost:3333 (só funciona na sua
# máquina com o XAMPP ligado) — por isso aparece "banco desconectado" quando
# publicado sem essa variável definida.
VITE_BACKEND_URL=https://www.seusite.com.br
