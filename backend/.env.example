# ─── Configuração do backend de cobranças PIX (Sicredi) ─────────────────────
# Copie este arquivo com o nome ".env" e preencha com os seus dados.
# NUNCA envie o .env nem a pasta certs/ para outras pessoas ou para a internet.

# ── Banco de dados (XAMPP / MySQL) ──────────────────────────────────────────
# Padrões do XAMPP: usuário "root" sem senha. O banco "coracaopresente" é
# criado automaticamente na primeira vez que o servidor subir.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=coracaopresente

# ── Sicredi (API Pix) ────────────────────────────────────────────────────────
# Ambiente: "homologacao" para testar sem dinheiro real | "producao" para valer
SICREDI_AMBIENTE=homologacao

# Credenciais geradas no Portal do Desenvolvedor do Sicredi
# (developer.sicredi.com.br → sua aplicação → credenciais)
SICREDI_CLIENT_ID=cole_aqui_o_client_id
SICREDI_CLIENT_SECRET=cole_aqui_o_client_secret

# Certificado digital da integração, convertido para PEM (veja o README.md)
SICREDI_CERT_PATH=./certs/cert.pem
SICREDI_KEY_PATH=./certs/key.pem

# Sua chave PIX cadastrada no Sicredi (a mesma das Configurações da loja)
PIX_CHAVE=sua_chave_pix_aqui

# ── Correios (rastreamento de encomendas) ───────────────────────────────────
# Credenciais do Portal Meu Correios (menu API → Credenciais). O usuário é o
# mesmo do portal; o CÓDIGO DE ACESSO é gerado lá dentro e NÃO é a senha; o
# cartão de postagem está no seu contrato.
#
# Deixe em branco se ainda não tem contrato: o rastreamento continua
# funcionando, mostrando só o andamento interno da loja (Processando → Em
# trânsito → Entregue), sem os eventos dos Correios.
CORREIOS_USUARIO=
CORREIOS_CODIGO_ACESSO=
CORREIOS_CARTAO_POSTAGEM=
# "producao" para valer | "homologacao" para testar
CORREIOS_AMBIENTE=producao

# ── Notificações no celular (Web Push) ──────────────────────────────────────
# Gere o par de chaves UMA vez (o arquivo fica só no servidor, nunca no Git):
#   openssl ecparam -genkey -name prime256v1 -noout -out vapid.pem
# Sem o arquivo, o site não oferece o botão de notificações — o e-mail de
# andamento do pedido continua funcionando normalmente.
VAPID_PEM=./vapid.pem
VAPID_CONTATO=mailto:contato@coracaopresente.com.br

# Porta do servidor (o site espera 3333 — só mude se souber o que está fazendo)
PORT=3333
