# Mapeia as rotas que o site chama para os arquivos PHP.
# Este arquivo deve ficar em public_html/api/ junto com os .php.
RewriteEngine On
RewriteBase /api/

# Força HTTPS também na API (mesma proteção do site)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Banco de dados
RewriteRule ^dados$ dados.php [L,QSA]
RewriteRule ^dados/([A-Za-z]+)$ dados.php?colecao=$1 [L,QSA]

# Avaliações de produto (comentário + vídeo do cliente)
RewriteRule ^avaliacoes$ avaliacoes.php [L,QSA]
RewriteRule ^avaliacoes/([0-9]+)$ avaliacoes.php?produtoId=$1 [L,QSA]

# Cobranças PIX
RewriteRule ^pix/cobranca$ pix.php?acao=cobranca [L,QSA]
RewriteRule ^pix/cobranca/([A-Za-z0-9]+)$ pix.php?acao=status&txid=$1 [L,QSA]

# Pagamento no cartão de crédito
RewriteRule ^cartao/pagamento$ cartao.php?acao=pagamento [L,QSA]
RewriteRule ^cartao/pagamento/([A-Za-z0-9]+)$ cartao.php?acao=status&transacaoId=$1 [L,QSA]

# Webhooks do Sicredi — o segredo faz parte do endereço.
# É o aviso do banco que marca um pagamento como recebido, então a rota não pode
# ficar aberta: sem o segredo certo o PHP responde 404 (ver WEBHOOK_SEGREDO em
# config.php). Cadastre no banco o endereço COMPLETO, com o segredo no fim:
#   https://coracaopresente.com.br/api/webhook/pix/SEU_SEGREDO
RewriteRule ^webhook/pix/([A-Za-z0-9_-]+)$ pix.php?acao=webhook&segredo=$1 [L,QSA]
RewriteRule ^webhook/cartao/([A-Za-z0-9_-]+)$ cartao.php?acao=webhook&segredo=$1 [L,QSA]
# As formas antigas, sem segredo, seguem mapeadas só para o PHP responder 404 de
# forma controlada — em vez de o Apache servir/expor o arquivo .php direto.
RewriteRule ^webhook/pix$ pix.php?acao=webhook [L,QSA]
RewriteRule ^webhook/cartao$ cartao.php?acao=webhook [L,QSA]

# Login do Admin (senha nunca fica no código do site — só aqui no servidor)
RewriteRule ^admin/login$ admin.php?acao=login [L,QSA]
RewriteRule ^admin/verificar-2fa$ admin.php?acao=verificar-2fa [L,QSA]
RewriteRule ^admin/logout$ admin.php?acao=logout [L,QSA]
RewriteRule ^admin/auditoria$ admin.php?acao=auditoria [L,QSA]

# Finalização de compra (grava só o que a compra mudou, não a tabela inteira)
RewriteRule ^checkout$ checkout.php [L,QSA]

# Pagamento semanal do vendedor: o que ele tem a receber nesta semana e o
# recibo de cada semana já fechada (com o botão de "pago" do Admin).
RewriteRule ^fechamentos$ fechamentos.php [L,QSA]
RewriteRule ^fechamentos/([0-9]+)$ fechamentos.php?id=$1 [L,QSA]

# Fotos guardadas no banco, servidas como imagem de verdade (imagem.php).
# É por aqui que o site busca cada foto: a resposta do /api/dados manda só
# estes endereços, em vez do base64 das fotos (que somava mais de 19 MB e
# derrubava o site). Também usadas nos e-mails de compra/entrega.
#   ?g={n} foto da galeria   ?c={n} foto da cor   ?v=... versão (cache)
RewriteRule ^produtos/([0-9]+)/imagem$ imagem.php?tipo=produto&id=$1 [L,QSA]
#   ?m=1 versão do banner para celular
RewriteRule ^banners/([0-9]+)/imagem$ imagem.php?tipo=banner&id=$1 [L,QSA]

# Produtos, um por vez (cadastro, edição, exclusão e ajuste de estoque)
RewriteRule ^produtos$ produtos.php [L,QSA]
RewriteRule ^produtos/([0-9]+)$ produtos.php?id=$1 [L,QSA]
RewriteRule ^produtos/([0-9]+)/estoque$ produtos.php?id=$1&acao=estoque [L,QSA]

# Compras (pagamento, cancelamento, confirmação manual de PIX pelo Admin)
RewriteRule ^compras$ compras.php [L,QSA]
RewriteRule ^compras/([A-Za-z0-9]+)$ compras.php?id=$1 [L,QSA]
RewriteRule ^compras/([A-Za-z0-9]+)/(cancelar|confirmar)$ compras.php?id=$1&acao=$2 [L,QSA]

# Cargo de uma conta, dado pelo Admin (uma por vez)
RewriteRule ^admin/cargo$ recrutamentos.php?acao=cargo-admin [L,QSA]

# Rastreamento público (nº do pedido + e-mail) — antes da regra genérica abaixo
RewriteRule ^pedidos/rastrear$ pedidos.php?acao=rastrear [L,QSA]

# Status de UM pedido (Admin)
RewriteRule ^pedidos/([^/]+)$ pedidos.php?id=$1 [L,QSA]

# Notificações no celular (Web Push)
RewriteRule ^push/chave-publica$ notificacoes.php?acao=chave-publica [L,QSA]
RewriteRule ^push/inscrever$ notificacoes.php?acao=inscrever [L,QSA]
RewriteRule ^push/pendentes$ notificacoes.php?acao=pendentes [L,QSA]

# Conta do cliente: cadastro, login (senha) e login com Google
RewriteRule ^clientes/cadastro$ clientes.php?acao=cadastro [L,QSA]
RewriteRule ^clientes/login$ clientes.php?acao=login [L,QSA]
RewriteRule ^clientes/verificar-2fa$ clientes.php?acao=verificar-2fa [L,QSA]
RewriteRule ^clientes/login-google$ clientes.php?acao=login-google [L,QSA]
RewriteRule ^clientes/logout$ clientes.php?acao=logout [L,QSA]
RewriteRule ^clientes/verificar-email$ clientes.php?acao=verificar-email [L,QSA]
RewriteRule ^clientes/reenviar-verificacao$ clientes.php?acao=reenviar-verificacao [L,QSA]
RewriteRule ^clientes/esqueci-senha$ clientes.php?acao=esqueci-senha [L,QSA]
RewriteRule ^clientes/redefinir-senha$ clientes.php?acao=redefinir-senha [L,QSA]

# Cliente ativa o código de vendedor recebido do Master
RewriteRule ^recrutamentos/([^/]+)/ativar$ recrutamentos.php?acao=ativar&codigo=$1 [L,QSA]

# Equipe do Master/MasterPlus: cadastrar vendedor e mudar cargo de quem já é da
# equipe. São rotas próprias (uma linha por vez) porque o painel do Master não
# tem — nem pode ter — token de Admin para usar a rota que grava a loja inteira.
RewriteRule ^recrutamentos$ recrutamentos.php?acao=criar [L,QSA]
RewriteRule ^equipe/cargo$ recrutamentos.php?acao=cargo [L,QSA]

# Bloqueia acesso direto aos arquivos de apoio.
# ATENÇÃO ao "config.*": o padrão antigo era "^(config|lib|...)\.php$", que
# casa com "config.php" mas NÃO com "config.local.php" — justamente o arquivo
# que guarda a senha do banco, a senha do Admin e a senha do SMTP. Normalmente
# o servidor executa o PHP (e o visitante recebe uma página vazia), mas se o
# PHP falhar ou for desligado, o Apache passa a entregar o arquivo como texto
# puro — e aí todas as senhas vazariam. Esta regra fecha essa porta.
<FilesMatch "^(config.*|lib.*|avisos|correios|smtp)\.php$">
  Require all denied
</FilesMatch>

# Rede de segurança: nenhum arquivo .local.* ou .env é servido, aconteça o que
# acontecer (vale para qualquer arquivo de segredo criado aqui no futuro).
<FilesMatch "(\.local\.|^\.env)">
  Require all denied
</FilesMatch>

# Avaliações podem chegar com vídeo em base64 (até ~16 MB) — o limite padrão
# de upload/post de alguns planos (ex.: 8 MB) rejeitaria o envio antes mesmo
# de rodar o PHP. Isso só funciona se o servidor usa mod_php; se não fizer
# efeito na KingHost, veja no Painel de Controle se há uma opção de PHP
# (php.ini personalizado) pra aumentar post_max_size / upload_max_filesize —
# ou peça ajuda ao suporte da KingHost.
<IfModule mod_php.c>
  php_value post_max_size 20M
  php_value upload_max_filesize 20M
  php_value memory_limit 128M
</IfModule>
